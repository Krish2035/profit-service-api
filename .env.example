# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Set DATABASE_URL for PostgreSQL (production, horizontal scaling)
# Example: postgresql://postgres:postgres@localhost:5432/profit_service
DATABASE_URL=
# Fallback local SQLite file path (used if DATABASE_URL is not set)
DATABASE_PATH=./profit_service.db

# Redis Configuration (multi-instance distributed rate limiting)
# Example: redis://localhost:6379
REDIS_URL=

# Authentication
# Used by POST /v1/auth/login to issue JWT tokens
API_KEY=dev_api_key_shopify_2026

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EXPIRES_IN=15m

# Rate Limiting
RATE_LIMIT_MAX=100
